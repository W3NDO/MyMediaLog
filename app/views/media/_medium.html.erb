<div id="<%= dom_id medium %>">
  <p class="my-5">
    <strong class="block font-medium mb-1">Media type:</strong>
    <%= medium.media_type %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Media name:</strong>
    <%= medium.media_name %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Rating:</strong>
    <%= medium.rating %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Review:</strong>
    <%= medium.review %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Status:</strong>
    <%= medium.status %>
  </p>

  <% if action_name != "show" %>
    <%= link_to "Show this medium", medium, class: "rounded-lg py-3 px-5 bg-gray-100 inline-block font-medium" %>
    <%= link_to 'Edit this medium', edit_medium_path(medium), class: "rounded-lg py-3 ml-2 px-5 bg-gray-100 inline-block font-medium" %>
    <hr class="mt-6">
  <% end %>
</div>

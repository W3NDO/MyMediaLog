<!DOCTYPE html>
<html>
  <head>
    <title>RailsMediaLog</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito&family=Poppins:ital,wght@0,300;0,400;1,300;1,400&family=Raleway:ital,wght@0,300;0,400;1,300;1,400&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="sm:overflow-x-scroll sm:overflow-y-hidden md:overflow-scroll overflow-hidden ">
    <main id="" class="overflow-y-hidden px-5 grid place-items-center font-sans">
      <div id="notification_container" class="w-full h-full"></div>
      <%= yield %>
    </main>
  </body>
</html>

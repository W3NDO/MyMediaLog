<% media_types = { :podcast =>  "Podcasts", :book =>  "Books", :youtubeVideo =>  "Youtube_Videos", :tvShow =>  "TV_Shows", :movies =>  "Movies", :music => "Music" } %>

<div class="lg:my-5 w-full overflow-x-hidden h-5/6 max-h-screen lg:grid grid-cols-6 grid-rows-6 flex-col">
    <aside id="sidebar" class="border border-gray-500 rounded-md shadow-md shadow-gray-500 mx-2 lg:row-start-1 lg:row-end-7 lg:col-start-1 lg:col-end-3 
                lg:grid grid-rows-6 overflow-y-scroll max-h">
      <div class="m-5">
        <span class="text-black border border-red-600"> <%= current_user.handle.nil? ? current_user.handle : current_user.email %> </span>
        <div class="flex flex-col">
          <% media_types.each do |type, value| %>
            <button type="button" class="p-2 m-2 bg-amber-400 rounded" data-reflex="click->Home#showMedia" data-media=<%= type %>> 
              <span class="text-xl font-sans3"> 
                <%= value.gsub("_", " ") %>
              </span> 
            </button>
          <% end %>
        </div>
      </div>
    </aside>

    <div id="main_conatiner" class="p-5 overflow-y-scroll lg:overflow-auto lg:mx-2 lg:row-start-1 lg:row-end-7 border border-gray-500 rounded-md shadow-md shadow-gray-500 col-start-3 col-end-7">
      <div class="flex flex-row justify-between">
        <h1 class="font-bold text-4xl font-sans2">My Media Log </h1>
        <button type="button" class="text-2xl border bg-amber-400 rounded-lg px-4" data-reflex="click->Home#showNewMediaForm">
          <i class="fa-solid fa-plus"></i>
        </button>
      </div>
        <div id="container" class="overflow-y-scroll">  </div>
    </div>
</div>
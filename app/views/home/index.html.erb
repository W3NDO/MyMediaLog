<% media_types = { :podcast =>  "Podcasts", :book =>  "Books", :youtubeVideo =>  "Youtube_Videos", :tvShow =>  "TV_Shows", :movies =>  "Movies", :music => "Music" } %>

<div class="lg:my-5 w-full overflow-x-hidden h-full lg:h-5/6 max-h-screen lg:grid grid-cols-6 grid-rows-6 flex-col">
    <aside
        id="sidebar"
        class="border border-gray-500 rounded-md shadow-md shadow-gray-500 lg:mx-2 lg:row-start-1 lg:row-end-7 lg:col-start-1 lg:col-end-3 lg:grid grid-rows-6 overflow-y-scroll max-h"
        data-controller="menu-control"
    >
      <div class="m-5">
        <button class="lg:hidden w-full bg-amber-400 rounded flex flex-row justify-around p-2 "
            data-action="click->menu-control#toggleDropwdown" type="button">

            <span>
                <span data-menu-control-target="toggleBtn">
                    <i class="fa-solid fa-bars"></i>
                </span>
                <span class="text-xl font-sans3 lg:hidden xl:hidden" id="context">
                    Menu
                </span>
            </span>
        </button>

        <div class="flex flex-col hidden lg:flex lg:flex-col" data-menu-control-target="dropdown">
          <% media_types.each do |type, value| %>
            <button
                type="button"
                class="p-2 m-2 bg-amber-400 rounded"
                data-action="click->menu-control#toggleDropwdown"
                data-reflex="click->Home#showMedia"
                data-media=<%= type %>
            >
              <span class="text-xl font-sans3">
                <%= value.gsub("_", " ") %>
              </span>
            </button>
          <% end %>
        </div>
      </div>
    </aside>

    <div id="main_conatiner" class="p-5 overflow-y-scroll lg:overflow-auto lg:mx-2 lg:row-start-1 lg:row-end-7 border border-gray-500 rounded-md shadow-md shadow-gray-500 col-start-3 col-end-7">
      <div class="flex flex-row justify-between">
        <h1 class="font-bold text-4xl font-sans">My Media Log </h1>
        <div id="focus">
          <%= render(partial: "home/new_media_button", locals: {media_type: "podcast"}) %>
        </div>
      </div>
        <div id="container" class="overflow-y-scroll">
          <%= render(partial: "home/landing_content") %>
        </div>
    </div>
</div>
